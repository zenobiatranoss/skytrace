# copy to .env and fill in what you need

APP_NAME=SkyTrace
DEBUG=false
LOG_LEVEL=INFO

# sqlite by default, point this at postgres later if you outgrow it
DATABASE_URL=sqlite:///./skytrace.db

# OpenSky access. anonymous works but is rate limited to a few hundred
# credits a day, so registering an api client is strongly recommended.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# clip the feed to a region to stretch your daily credits: a boxed request
# costs a fraction of the whole-world one. lamin,lomin,lamax,lomax.
# empty (the default) means whole world.
# example - Europe: OPENSKY_BOUNDS=35,-12,60,30
OPENSKY_BOUNDS=

# which position feeds to use, in priority order (first wins when merging).
# built-in: "opensky", "adsb" (adsb.lol, global), "adsbfi" (adsb.fi, only
# reaches 250nm so it's a regional add-on and is skipped when the area is
# bigger than that). listing more than one makes us fetch them all and
# merge by icao24, so one source being down or rate limited no longer
# takes the map with it.
# example - direct adsb feed, opensky as fallback:
#   POSITION_SOURCES=adsb,opensky
POSITION_SOURCES=opensky

# adsb feed (any readsb/tar1090 style json api). api.adsb.lol is public and
# needs no key. readsb has no whole-world endpoint, so it needs an area: we
# reuse OPENSKY_BOUNDS when set, otherwise this center + radius.
# some feeds reject blank/scripted user agents, hence the explicit one.
ADSB_BASE_URL=https://api.adsb.lol
ADSB_USER_AGENT=SkyTrace/0.1
# example - London: ADSB_CENTER=51.5,-0.1
ADSB_CENTER=
ADSB_RADIUS_NM=250
# a globe-spanning radius around ADSB_CENTER=0,0 pulls every aircraft in
# one call (~11k). heavy on the feed, so only do it if you really want the
# whole world: ADSB_RADIUS_NM=20000
# also pull adsb's globally scoped military feed
ADSB_MILITARY=false

# seconds between position polls. the credit budget is the real limit here:
# whole-world polls at 15s will exhaust the daily quota in under an hour.
# pair a slower interval with OPENSKY_BOUNDS to keep it running all day.
POSITION_REFRESH_SECONDS=30
# a position older than this shows up as stale in the ui
POSITION_STALE_SECONDS=60
# drop recorded track points older than this
HISTORY_RETENTION_HOURS=24

# optional: path to an OurAirports csv export for airport data.
# leave empty and airport lookups just return nothing.
AIRPORTS_DATASET_PATH=

# adsbdb gives real routes (airline + origin/destination airports) plus
# aircraft registration, type and a photo, no key needed. looked up lazily
# when someone opens an aircraft and cached hard, so it costs almost
# nothing. set to false to run fully local (csv only).
ADSBDB_ENABLED=true
ADSBDB_BASE_URL=https://api.adsbdb.com
ADSBDB_TIMEOUT=10

# optional: path to the OpenSky aircraft database csv export. when set we
# fill in registration/type/operator for the aircraft we've seen.
AIRCRAFT_DATASET_PATH=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
